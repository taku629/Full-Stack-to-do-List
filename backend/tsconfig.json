{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",           // ここを node16 に変更
    "moduleResolution": "node16", // ここも node16 に変更
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}